    "coordinate_displacement": "none; start at exact supplied XYZ coordinates",
    "float_dtype": "numpy.float64",
    "mode_internal_definition": "remove_translation_rotation(public displacement, supplied coordinates, electron-mass array)",
    "mode_kick_definition": "0.5 * sum_i(m_i * |v_kick_i|^2) = mode_kick_kcal_mol",
    "mode_projection": "c = sum_i(m_i * thermal_i dot mode_internal_i) / sum_i(m_i * |mode_internal_i|^2); thermal -= c * mode_internal",
    "mode_sign_application": "v_final = thermal_rescaled + mode_sign * sqrt(2*(mode_kick_kcal_mol/kcal_mol_per_hartree)/mode_mass_norm2) * mode_internal",
    "operation_order": [
      "draw",
      "remove_translation_rotation",
      "project_mode",
      "remove_translation_rotation",
      "rescale_thermal",
      "add_mode_kick"
    ],
    "pseudoinverse_rcond": 1e-12,
    "provenance_schema": {
      "removed_rotation": "required boolean true",
      "removed_translation": "required boolean true",
      "rotation_residual": "optional numeric or structured diagnostic",
      "translation_residual": "optional numeric or structured diagnostic"
    },
    "reactive_mode_projection_record": "with u=public_mode/l2_norm(public_mode), sum_i(m_i*v_final_i dot u_i)/sqrt(sum_i(m_i*|u_i|^2))",
    "rigid_body_removal": "remove mass-weighted COM velocity; use mass-centered supplied coordinates; I=sum m*((r dot r)I3-r outer r), L=sum cross(r,mv), omega=pinv(I,rcond=1e-12)@L, v-=cross(omega,r); remove COM velocity again",
    "thermal_dof": "3N-7",
    "velocity_distribution": "normal(0, sqrt(k_B*T/mass)) per Cartesian component"
  },
  "integrator": "velocity-Verlet NVE",
  "integrator_contract": {
    "acceleration": "-gradient_eh_per_bohr / mass_electron",
    "coordinate_internal_unit": "bohr",
    "frame_count_complete": 41,
