      "velocities_bohr_per_au": [
        53,
        3
      ]
    },
    "frame_velocity_semantics": "step 0 uses initialized velocity; step n>0 uses post-update v_next",
    "frame_time_rule": "time_fs = step * timestep_fs",
    "gradient_rms_definition": "sqrt(mean over all 3N Cartesian gradient components of gradient_ij^2)",
    "step_order": [
      "q_next = q + v*dt + 0.5*a*dt^2",
      "evaluate pinned RKS energy and analytic gradient at q_next",
      "a_next = -gradient_next/mass",
      "v_next = v + 0.5*(a+a_next)*dt",
      "atomically checkpoint native receipt, marker, and JSON frame"
    ],
    "timestep_internal": "dt = timestep_fs * initialization.constants.atomic_time_per_fs"
  },
